#!/bin/bash
#SBATCH -J wilson-j4-fulltime
#SBATCH -p kshdnormal
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=dcu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=72:00:00
#SBATCH --comment=BASE
#SBATCH --array=0-7%1
#SBATCH -o REPLACE_RESULT_ROOT/logs/%A_%a.out
#SBATCH -e REPLACE_RESULT_ROOT/logs/%A_%a.err

set -euo pipefail

# Replace these values in the generated copy before submission.
SOURCE_ROOT="REPLACE_SOURCE_ROOT"
PYTHON="REPLACE_PYTHON"
CURRENT_ARTIFACT_ROOT="REPLACE_CURRENT_ARTIFACT_ROOT"
VSV_ROOT="REPLACE_VSV_ROOT"
SOURCE_MANIFEST="REPLACE_SOURCE_MANIFEST"
RESULT_ROOT="REPLACE_RESULT_ROOT"
CURRENT_NE="REPLACE_CURRENT_NE"
WILSON_R="REPLACE_WILSON_R"
CURRENT_DIRECTION="3"
CONFIGURATIONS=(10000 13000 14000 15000 16000 17000 18000 19000)

# Site module setup must match the approved Kunshan PyQUDA/CuPy environment.
source "$HOME/.bashrc"
cd "$SOURCE_ROOT"
mkdir -p "$RESULT_ROOT/logs"

export PYTHONPATH="$SOURCE_ROOT:${PYTHONPATH:-}"
export LATTICE_EXECUTION_CLUSTER=kunshan
export LATTICE_SOURCE_GIT_COMMIT="REPLACE_SOURCE_GIT_COMMIT"
export LATTICE_SOURCE_GIT_DIRTY="REPLACE_SOURCE_GIT_DIRTY"
export LATTICE_EXECUTION_RESOURCES_JSON='{"mode":"dcu-fulltime-vsv-pair","nodes":1,"cpus":8,"dcu":1,"array_concurrency":1}'

CFG="${CONFIGURATIONS[$SLURM_ARRAY_TASK_ID]}"
CURRENT_ARTIFACT="$CURRENT_ARTIFACT_ROOT/$CFG/current-artifact"
VSV_DIRECTORY="$VSV_ROOT"
ITEM_ROOT="$RESULT_ROOT/$CFG"
mkdir -p "$ITEM_ROOT"

exec "$PYTHON" "$SOURCE_ROOT/experiments/directed-current-v2v/run_fulltime_vsv_pair_ensemble.py" \
  --configuration "$CFG" \
  --current-artifact "$CURRENT_ARTIFACT" \
  --vsv-directory "$VSV_DIRECTORY" \
  --source-manifest "$SOURCE_MANIFEST" \
  --result-root "$RESULT_ROOT" \
  --current-ne "$CURRENT_NE" \
  --wilson-r "$WILSON_R" \
  --backend cupy \
  --current-direction "$CURRENT_DIRECTION" \
  --first-momentum-index 0 \
  --second-momentum-index 0
